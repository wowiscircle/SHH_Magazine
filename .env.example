# Public application URL used for canonical and sitemap URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side Basic Auth for the protected /admin route.
ADMIN_USERNAME=pilot-admin
ADMIN_PASSWORD=replace-with-a-long-random-secret

# Debug is rendered only inside the protected admin route.
ADMIN_ANALYTICS_DEBUG=false

# Optional best-effort server analytics adapter.
ANALYTICS_ENDPOINT=
